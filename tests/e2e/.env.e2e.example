# Copy this file to .env.e2e and fill in values before running E2E tests.
# Never commit .env.e2e — it contains credentials.
#
# Usage:
#   export $(cat tests/e2e/.env.e2e | xargs)
#   pytest tests/e2e/ -v -m smoke
#
# Or use python-dotenv to load automatically via conftest.py.

# ── Environment selection ──────────────────────────────────────────────────────
TEST_ENV=digilux-qa          # digilux-qa | honeywell-qa

# ── Test user (Cognito account — dedicated test account, not a real user) ──────
TEST_USER_EMAIL=testuser@your-domain.com
TEST_USER_PASSWORD=YourTestPassword123!
TEST_SITE_ID=your-site-id-here

# ── Device for fulfillment tests (must belong to TEST_USER) ───────────────────
TEST_DEVICE_ID=your-device-id-here

# ── Google Home OAuth client secret (from Google Actions Console) ─────────────
TEST_GH_CLIENT_SECRET=your-gh-client-secret

# ── Pre-obtained tokens (optional — skip browser flows if set) ────────────────
# Obtain by running test_link_flow.py once and copying the returned tokens here.
TEST_GH_ACCESS_TOKEN=
TEST_GH_REFRESH_TOKEN=
TEST_ALEXA_LWA_TOKEN=

# ── Amazon account (for Alexa app-to-app LWA login — browser tests only) ──────
TEST_AMAZON_EMAIL=your-amazon-test-account@example.com
TEST_AMAZON_PASSWORD=YourAmazonPassword123!

# ── Fallback: pre-obtained Cognito JWT (if USER_PASSWORD_AUTH not enabled) ────
# TEST_COGNITO_JWT=eyJraWQ...
