# .env.example — Alexa App-to-App Account Linking
#
# Copy this file to .env for local development.
# In AWS Lambda, set these as Lambda environment variables in the function config
# (console, SAM, CDK, or deploy.sh).
#
# NEVER commit a .env file with real secrets to source control.

# ── Logging ────────────────────────────────────────────────────────────────────
# DEBUG  : full request trace, DDB calls, PKCE details, HTTP request/response
# INFO   : key milestones + all [AUDIT] events (recommended for production)
# WARNING: auth failures and validation errors only
LOG_LEVEL=INFO

# ── AWS Region ─────────────────────────────────────────────────────────────────
# Region where DynamoDB tables live
DATA_REGION=ap-south-1

# ── DynamoDB Tables ────────────────────────────────────────────────────────────
# Session table: created by deploy.sh, stores PKCE + state for 10 min
SESSION_TABLE=alexa_app_linking_sessions

# LWA token table: stores access + refresh tokens after successful linking
LWA_TOKENS_TABLE=digilux_honeywell_alexa_lwa_tokens

# ── Session TTL ────────────────────────────────────────────────────────────────
# How long (seconds) a PENDING session is valid before it expires
# Default 600 = 10 minutes (matches Alexa's typical authorization code window)
SESSION_TTL_SECONDS=600

# ── OAuth Redirect URI ─────────────────────────────────────────────────────────
# Must match exactly what is registered in the Alexa Developer Console
# under Skill > Account Linking > Redirect URLs
REDIRECT_URI=https://www.digilux.co.in/alexa/callback

# ── Amazon LWA (Login with Amazon) ────────────────────────────────────────────
# ARN of the Secrets Manager secret holding { "client_id": "...", "client_secret": "..." }
LWA_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:986906626244:secret:digilux/alexa/lwa-7RDOUm

# Region where the LWA secret is stored (may differ from DATA_REGION)
LWA_SECRET_REGION=eu-west-1

# Amazon's OAuth token endpoint — rarely changes, but configurable for future-proofing
LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# HTTP timeout (seconds) for LWA token exchange and Skill Enablement API calls
LWA_HTTP_TIMEOUT=10

# Seconds to subtract from expires_in when storing token expiry (clock-skew buffer)
TOKEN_EXPIRY_BUFFER_SECONDS=60

# ── Alexa Skill ────────────────────────────────────────────────────────────────
# Full Alexa skill ID — find in Alexa Developer Console > Your Skill > Skill ID
ALEXA_SKILL_ID=amzn1.ask.skill.<YOUR_SKILL_ID_HERE>

# Skill stage to enable for the user after account linking completes
# Values: live | development
ALEXA_SKILL_STAGE=live

# Base URL for the Alexa Skill Enablement API (~current resolves from Bearer token)
SKILL_ENABLEMENT_URL=https://api.amazonalexa.com/v1/users/~current/skills

# ── Flutter App Deep Link ──────────────────────────────────────────────────────
# Custom URI scheme registered in AndroidManifest.xml / Info.plist
# The callback Lambda builds: <APP_SCHEME>://alexa/callback?code=X&state=Y
APP_SCHEME=digilux

# ── Security — JWT Signature Verification ─────────────────────────────────────
# Cognito User Pool ID: enables RS256 JWT signature verification (defense-in-depth)
# Leave empty to skip (not recommended for production)
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX

# Region where the Cognito User Pool lives (defaults to DATA_REGION if omitted)
COGNITO_REGION=ap-south-1

# ── Security — KMS Field-Level Encryption ─────────────────────────────────────
# ARN of the KMS key used to encrypt codeVerifier and LWA tokens at rest in DynamoDB
# Leave empty to store in plaintext (not recommended for production)
KMS_KEY_ARN=arn:aws:kms:ap-south-1:986906626244:key/<YOUR_KMS_KEY_ID>

# ── Security — Rate Limiting ───────────────────────────────────────────────────
# Max number of PENDING linking sessions a single user can create per TTL window
MAX_PENDING_SESSIONS_PER_USER=5

# ── Security — Input Size Limits ──────────────────────────────────────────────
# Maximum request body size in bytes for completeAppToApp (prevents oversized payloads)
MAX_REQUEST_BODY_BYTES=4096

# Maximum length of the OAuth authorization code (prevents oversized code attacks)
MAX_AUTH_CODE_LEN=2048

# ── Security — Redirect URI Allowlist ─────────────────────────────────────────
# Comma-separated list of allowed redirect URI hostnames (startup validation)
# Leave empty to skip host allowlist check
ALLOWED_REDIRECT_HOSTS=www.digilux.co.in

# ── Token Revocation (for unlink flow) ────────────────────────────────────────
# Amazon LWA token revocation endpoint — used by alexa_unlink to invalidate refresh tokens
LWA_REVOKE_URL=https://api.amazon.com/auth/o2/revoke
